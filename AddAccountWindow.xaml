<Window x:Class="SteamSwitcher.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генерация нового аккаунта" Height="380" Width="430"
        Background="#1B2838" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,6">
            <TextBlock Text="Логин:" Width="90" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <Button Content="📋 Копировать" DockPanel.Dock="Right" Width="100" Click="CopyLogin_Click" Background="#3D5A70" Foreground="White" BorderThickness="0"/>
            <TextBox x:Name="LoginBox" Background="#2A475E" Foreground="White" BorderThickness="0" Padding="6" FontSize="13" Margin="0,0,8,0"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,6">
            <TextBlock Text="Пароль:" Width="90" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <Button Content="📋 Копировать" DockPanel.Dock="Right" Width="100" Click="CopyPass_Click" Background="#3D5A70" Foreground="White" BorderThickness="0"/>
            <TextBox x:Name="PassBox" Background="#2A475E" Foreground="White" BorderThickness="0" Padding="6" FontSize="13" Margin="0,0,8,0"/>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,6">
            <TextBlock Text="Почта:" Width="90" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="EmailBox" Background="#2A475E" Foreground="White" BorderThickness="0" Padding="6" FontSize="13"/>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,6">
            <TextBlock Text="Пасс почты:" Width="90" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="EmailPassBox" Background="#2A475E" Foreground="White" BorderThickness="0" Padding="6" FontSize="13"/>
        </DockPanel>

        <CheckBox x:Name="AutoConfigCheck" Grid.Row="4" Content="Автоматически скопировать конфиг из Избранного" 
                  Foreground="#66C0F4" FontSize="12" Margin="0,12" IsChecked="True"/>

        <Button Grid.Row="5" Content="💾 СОХРАНИТЬ В БАЗУ" VerticalAlignment="Bottom" Height="45" 
                Background="#5c7e10" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <CornerRadius Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>