<Window x:Class="SteamSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Steam Center Ultimate 2026" Height="650" Width="850"
        Background="#1B2838" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#171A21"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D5A70"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="STEAM CENTER PRO v4.5" Foreground="#66C0F4" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="SourceStatus" Text=" | Конфиг не выбран" Foreground="#A0A0A0" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
        </StackPanel>

        <ListBox x:Name="AccountsList" Grid.Row="1" Background="#171A21" BorderThickness="0" 
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2A475E" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📋 Скопировать Логин" Click="CopyLogin_Click" Tag="{Binding AccountName}"/>
                                <MenuItem Header="{Binding PassLabel}" Click="ManagePass_Click" Tag="{Binding AccountName}"/>
                                <MenuItem Header="{Binding EmailLabel}" Click="ManageEmail_Click" Tag="{Binding AccountName}"/>
                                <Separator Background="#3D5A70"/>
                                <MenuItem Header="⭐ В избранное / Убрать" Click="Favorite_Click" Tag="{Binding AccountName}"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="★" Grid.Column="0" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{Binding FavoriteColor}" 
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Ellipse Width="55" Height="55" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="{Binding PersonaName}" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="#66C0F4"/>
                                <TextBlock Text="{Binding LastLoginFormatted}" FontSize="10" Foreground="#8F98A0" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="5,0">
                                <Button Content="ВЗЯТЬ КОНФИГИ" Click="SetSource_Click" Tag="{Binding AccountID32}" 
                                        Height="24" Margin="0,2" Background="#1B2838" Foreground="White" FontSize="10" BorderThickness="0"/>
                                <Button Content="ПРИМЕНИТЬ ВСЕМ" Click="ApplySource_Click" Tag="{Binding AccountID32}" 
                                        Height="24" Margin="0,2" Background="#3D5A70" Foreground="#66C0F4" FontSize="10" BorderThickness="0"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="ВОЙТИ" Click="LoginButton_Click" Tag="{Binding AccountName}" 
                                    Height="50" Background="#5c7e10" Foreground="White" FontWeight="Bold" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="➕ НОВЫЙ АКК" Width="170" Height="45" Margin="5" Background="#2196F3" Foreground="White" FontWeight="Bold" Click="GenerateAccount_Click"/>
            <Button Content="📂 БАЗА TXT" Width="140" Height="45" Margin="5" Background="#FF9800" Foreground="White" FontWeight="Bold" Click="OpenDatabase_Click"/>
            <Button Content="🔄 ОБНОВИТЬ" Width="130" Height="45" Margin="5" Background="#673AB7" Foreground="White" FontWeight="Bold" Click="RefreshList_Click"/>
        </StackPanel>
    </Grid>
</Window>