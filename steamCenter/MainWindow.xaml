<Window x:Class="steamCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Center Ultimate 2026" 
        Height="720" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1B2838"
        ResizeMode="CanResize"
        MinHeight="600"
        MinWidth="800">

    <Window.Resources>
        <SolidColorBrush x:Key="SteamBlue" Color="#66C0F4"/>
        <SolidColorBrush x:Key="DarkBg" Color="#1B2838"/>
        <SolidColorBrush x:Key="CardBg" Color="#2A475E"/>
        <SolidColorBrush x:Key="ScrollBg" Color="#171A21"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#5c7e10"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="TextGray" Color="#8F98A0"/>
        <SolidColorBrush x:Key="AvatarBg" Color="#3D5A70"/>

        <Style x:Key="SteamButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Background" Value="#5c7e10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3" 
                                Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="STEAM CENTER ULTIMATE 2026" 
                       Foreground="{StaticResource SteamBlue}" 
                       FontSize="22" 
                       FontWeight="Bold"/>

            <TextBlock x:Name="StatusLabel" 
                       Grid.Column="1"
                       Text=" | Конфиг не выбран" 
                       Foreground="{StaticResource TextGray}" 
                       FontSize="12"
                       Margin="10,0,0,0"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Список аккаунтов с прокруткой -->
        <ScrollViewer Grid.Row="1" 
                      Background="{StaticResource ScrollBg}" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="AccountsPanel" 
                        Background="{StaticResource ScrollBg}"
                        Orientation="Vertical"/>
        </ScrollViewer>

        <!-- Нижняя панель кнопок -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Margin="0,15,0,0" 
                    HorizontalAlignment="Left">
            <Button x:Name="BtnNewAccount" 
                    Style="{StaticResource SteamButton}"
                    Background="#2196F3"
                    Content="➕ НОВЫЙ АКК"
                    Click="BtnNewAccount_Click"/>
            <Button x:Name="BtnOpenDatabase" 
                    Style="{StaticResource SteamButton}"
                    Background="#FF9800"
                    Content="📂 БАЗА DATA"
                    Click="BtnOpenDatabase_Click"
                    Margin="10,0,0,0"/>
            <Button x:Name="BtnRefresh" 
                    Style="{StaticResource SteamButton}"
                    Background="#673AB7"
                    Content="🔄 ОБНОВИТЬ"
                    Click="BtnRefresh_Click"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>